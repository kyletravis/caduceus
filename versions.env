# Upstream sources that bin/setup clones into ./vendor at these exact commits.
# SearXNG's dated container image is pinned separately in docker-compose.yml.
# Bump these deliberately: re-run bin/setup, rebuild, and check integrations.

HERMES_REPO=https://github.com/NousResearch/hermes-agent.git
HERMES_REF=v0.22.7
HERMES_COMMIT=b200f5bc60e31588ba2cb60e288029c4a54ba5fa

# Mnemosyne is not cloned: hermes-init installs it from the Hermes plugin
# catalog at this commit, which matches the catalog's reviewed pin. The plugin
# then installs its mnemosyne-hermes and mnemosyne-memory packages from PyPI.
MNEMOSYNE_REPO=https://github.com/mnemosyne-oss/mnemosyne.git
MNEMOSYNE_VERSION=0.7.3
MNEMOSYNE_COMMIT=d73848735a2a48471a62d2c8fb96cd7183c97491
