#!/usr/bin/env bash
#
# Show container state and probe each service's health endpoint.
set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

env_get() { grep -E "^$1=" .env 2>/dev/null | head -1 | cut -d= -f2- || true; }
port() { local p; p="$(env_get "$1")"; printf '%s' "${p:-$2}"; }

docker compose ps --format 'table {{.Service}}\t{{.State}}\t{{.Status}}'
echo

check() {  # check LABEL URL [curl args...]
  local label="$1" url="$2"; shift 2
  if curl -fsS -m 10 -o /dev/null "$@" "$url"; then
    printf '  %-12s ok\n' "$label"
  else
    printf '  %-12s FAILED  (%s)\n' "$label" "$url"
  fi
}

echo "Health checks:"
check "Hermes API" "http://127.0.0.1:$(port API_SERVER_PORT 8642)/v1/models" \
  -H "Authorization: Bearer $(env_get API_SERVER_KEY)"
check "Dashboard" "http://127.0.0.1:$(port DASHBOARD_PORT 9119)/"
check "SearXNG"   "http://127.0.0.1:$(port SEARXNG_PORT 8088)/search?q=test&format=json"

# The model server runs on the host, so probe it from the host side.
base="$(env_get CADUCEUS_LLM_BASE_URL)"
check "Models" "${base/host.docker.internal/127.0.0.1}/models" \
  -H "Authorization: Bearer $(env_get CADUCEUS_LLM_API_KEY)"
