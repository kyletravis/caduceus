-        bind_path, pointer_file = resolve_server_socket_path(self._home)
+    async def _start_posix(self, fallback: bool = False) -> bool:
+        bind_path, pointer_file = ((_fallback_socket_path(self._home), self._home / _POINTER_FILENAME)
+                                   if fallback else resolve_server_socket_path(self._home))
         if pointer_file is not None:
             with contextlib.suppress(FileExistsError):
                 bind_path.parent.mkdir(mode=0o700)
@@ -253,6 +254,16 @@ class GatewayControlServer:
             os.umask(old_umask)
         with contextlib.suppress(OSError):
             os.chmod(bind_path, 0o600)
+        if pointer_file is None and stat.S_IMODE(bind_path.lstat().st_mode) & 0o077:
+            # Some filesystems cannot store a socket's mode (a Docker Desktop bind mount reports 0755
+            # whatever chmod asks) and clients refuse an open socket: serve from the temp-dir
+            # fallback instead, as for a home too long for sun_path.
+            logger.warning("Control socket %s cannot be made private; using a temp-dir socket", bind_path)
+            self._server.close()
+            await self._server.wait_closed()
+            self._server = None
+            bind_path.unlink(missing_ok=True)
+            return await self._start_posix(fallback=True)
         self._bind_path = bind_path
         info = bind_path.lstat()
         self._file_identities[bind_path] = (info.st_dev, info.st_ino)
