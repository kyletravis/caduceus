+def test_home_that_cannot_hold_private_socket_uses_pointer(home: Path, monkeypatch):
+    # A Docker Desktop bind mount keeps every socket at 0755: strict discovery must still attach.
+    import os
+
+    from gateway import control_socket
+    from hermes_cli.gateway_runtime_discovery import query_identify
+
+    if not control_socket._fits_sun_path(home / "gateway.sock"):
+        pytest.skip("home already uses the pointer fallback")
+    real_umask, real_chmod = os.umask, os.chmod
+    monkeypatch.setattr(control_socket.os, "umask", lambda mask: real_umask(0o022))
+    monkeypatch.setattr(control_socket.os, "chmod", lambda path, mode: real_chmod(
+        path, 0o755 if Path(path).name == "gateway.sock" else mode))
+
+    async def scenario():
+        server = GatewayControlServer(home, verb_handlers={"identify": lambda: {"pid": 11}})
+        assert await server.start()
+        try:
+            assert not (home / "gateway.sock").exists()
+            assert (home / "gateway.sock.path").is_file()
+            loop = asyncio.get_running_loop()
+            return await loop.run_in_executor(None, lambda: query_identify(home, timeout=2))
+        finally:
+            await server.stop()
+
+    assert _run(scenario())["pid"] == 11
+    assert not (home / "gateway.sock.path").exists()
+
+
 def test_no_socket_returns_none_fast(home: Path):
     assert identify_gateway(home) is None
