# ============================================================================
# Caduceus settings. Copy to .env (bin/setup does this for you) and fill in.
# .env holds secrets: never commit it.
# ============================================================================

# ----------------------------------------------------------------------------
# Host user that owns ./data/hermes. bin/setup fills these in with `id -u`/`id -g`.
# ----------------------------------------------------------------------------
HERMES_UID=1000
HERMES_GID=1000
# Where Hermes keeps its state (config, sessions, memory cache, skills).
HERMES_DATA_DIR=./data/hermes

# ----------------------------------------------------------------------------
# Obsidian vault the agent reads and writes, mounted at /opt/vault and kept in
# sync by the obsidian-sync service (run bin/obsidian-sync setup once), e.g.
#   OBSIDIAN_VAULT_DIR="/Users/you/obsidian/AI Vault"
# The default is an empty vault under ./data that sync fills in.
# ----------------------------------------------------------------------------
OBSIDIAN_VAULT_DIR=./data/obsidian

# ----------------------------------------------------------------------------
# Models: any OpenAI-compatible server (Ollama, LM Studio, vLLM, a router such
# as NVIDIA PAIR, or a hosted API). Containers reach the host through
# host.docker.internal. Examples:
#   Ollama     http://host.docker.internal:11434/v1
#   LM Studio  http://host.docker.internal:1234/v1
#   vLLM       http://host.docker.internal:8000/v1
# ----------------------------------------------------------------------------
CADUCEUS_LLM_BASE_URL=http://host.docker.internal:11434/v1
# Local servers usually ignore the key, but the clients reject an empty one.
CADUCEUS_LLM_API_KEY=local

# The agent's main model: needs good tool calling and a long context.
CADUCEUS_AGENT_MODEL=qwen3.6-35b-a3b

# ----------------------------------------------------------------------------
# Hermes OpenAI-compatible API (http://127.0.0.1:8642/v1). bin/setup generates
# the key. Set API_SERVER_BIND=0.0.0.0 only behind a firewall or reverse proxy.
# ----------------------------------------------------------------------------
API_SERVER_KEY=
API_SERVER_BIND=127.0.0.1
API_SERVER_PORT=8642

# ----------------------------------------------------------------------------
# Web dashboard (http://127.0.0.1:9119), supervised inside the hermes container.
# It refuses to start without a login.
# The dashboard can run commands on the server, so pick a strong password.
# ----------------------------------------------------------------------------
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
DASHBOARD_PORT=9119

# ----------------------------------------------------------------------------
# Matrix chat (optional). Leave MATRIX_HOMESERVER empty to keep Matrix off.
# Use a dedicated bot account. See INSTALL.md, "Connect Matrix".
# ----------------------------------------------------------------------------
MATRIX_HOMESERVER=
# e.g. @caduceus:matrix.example.org
MATRIX_USER_ID=
# Password login, or set MATRIX_ACCESS_TOKEN instead.
MATRIX_PASSWORD=
MATRIX_ACCESS_TOKEN=
# Pin a device ID so encryption keys survive restarts (e.g. CADUCEUS_BOT).
MATRIX_DEVICE_ID=
# Recovery key from the bot account's secure backup, for cross-signing.
MATRIX_RECOVERY_KEY=
# off | optional | required
MATRIX_E2EE_MODE=optional
# Comma-separated users allowed to talk to the bot, e.g. @you:matrix.example.org
MATRIX_ALLOWED_USERS=
# Room ID (starts with "!") for scheduled-job delivery and notifications.
MATRIX_HOME_ROOM=
# Comma-separated room IDs where the bot answers without being @mentioned.
MATRIX_FREE_RESPONSE_ROOMS=

# ----------------------------------------------------------------------------
# SearXNG. bin/setup generates the secret.
# ----------------------------------------------------------------------------
SEARXNG_SECRET=

# ----------------------------------------------------------------------------
# Host ports (all bound to 127.0.0.1). Change these to run beside other services.
# ----------------------------------------------------------------------------
SEARXNG_PORT=8088
